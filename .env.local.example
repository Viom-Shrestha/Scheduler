# Local dev needs nothing — lib/db.ts defaults to a plain SQLite file at
# ./data/tasks.db when these are unset.

# To deploy (e.g. on Vercel), create a free database at https://turso.tech,
# then set these two and redeploy. No code changes needed.
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token
